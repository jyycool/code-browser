{
  "name": "code-browser-app",
  "productName": "code-browser",
  "version": "0.1.0",
  "description": "Desktop shell that embeds the code-browser engine in its own window (Windows).",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "code-browser": "file:../sdk/node",
    "koffi": "2.9.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/ws": "8.5.13",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "license": "BSD-3-Clause"
}
